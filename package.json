{
  "name": "rosen-place",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:secure": "vercel dev",
    "build": "tsc -b && vite build && vite build --config vite.login.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "admin": "tsx --env-file-if-exists=.env.local scripts/admin.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@vercel/functions": "^3.11.3",
    "hono": "^4.13.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vercel": "^66.6.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
