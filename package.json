{
  "name": "rosen-place",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:secure": "npm run build && wrangler d1 migrations apply rosen-place --local && wrangler dev",
    "build": "tsc -b && vite build && vite build --config vite.login.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "admin": "node scripts/admin.mjs",
    "deploy": "npm run build && wrangler d1 migrations apply rosen-place --remote --env production && wrangler deploy --env production"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "hono": "^4.13.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
